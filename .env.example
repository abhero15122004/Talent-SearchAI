# ===================================================================
# TalentMatch AI - Environment Variables Reference (.env.example)
# Copy this file to .env or export these variables in your shell.
# Never commit real secrets or production credentials to source control!
# ===================================================================

# --- Spring Boot Backend Configuration ---
SERVER_PORT=8080

# Database Connectivity (MySQL 8.x)
# In local development without MySQL, you can use the 'dev' profile (-Dspring-boot.run.profiles=dev) which runs in-memory H2.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/talentmatch_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=talentmatch_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Hibernate & Flyway
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=true

# Security & Stateless JWT Authentication
# The secret must be at least 256 bits (32+ characters) long.
APP_SECURITY_JWT_SECRET=TalentMatchAIEnterpriseRecruitmentSecretKey2026SecureHMACSHA256Token
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# Development Seed Accounts (Only enabled when APP_SECURITY_INIT_DEV_DATA=true)
# If passwords are not provided, secure random 16-character passwords will be generated and logged once.
APP_SECURITY_INIT_DEV_DATA=true
APP_SECURITY_DEV_ADMIN_PASSWORD=AdminPass2026!
APP_SECURITY_DEV_RECRUITER_PASSWORD=RecruiterPass2026!

# --- Frontend Configuration (Vite + React) ---
# Base API URL consumed by axios client in frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Python NLP/AI Service (FastAPI - Target Phase 4) ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_MODEL_NAME=all-MiniLM-L6-v2

# --- RabbitMQ Message Broker (Phase 7 Async Pipeline) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
