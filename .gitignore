# ===================================================================
# TalentMatch AI - Comprehensive .gitignore
# ===================================================================

# Environment files, secrets & local overrides
.env
.env.local
.env.*.local
*.env
application-local.properties
application-secret.properties
application-*.secret.properties

# Backend (Maven & Java)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Frontend (Node, Vite & TypeScript)
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Python AI Service (Virtualenvs, Cache, Model Artifacts)
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/
.ruff_cache/

# AI Models & Embeddings Caches
.cache/
models_cache/
huggingface/
torch/

# Uploads & Temporary Parsing Artifacts
uploads/
resumes/
temp/
tmp/
*.tmp

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Log files
*.log
logs/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
